// Icon, manifest and version information for winshell.exe (PLAN.md section 10).
// Template: build.rs fills in the version (from Cargo.toml) and the resource folder path.

1 ICON "@DIR@/winshell.ico"
1 24 "@DIR@/winshell.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WinShellTheme"
            VALUE "FileDescription", "WinShellTheme desktop shell overlay"
            VALUE "FileVersion", "@VERSION_STR@"
            VALUE "InternalName", "winshell"
            VALUE "OriginalFilename", "winshell.exe"
            VALUE "ProductName", "WinShellTheme"
            VALUE "ProductVersion", "@VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
